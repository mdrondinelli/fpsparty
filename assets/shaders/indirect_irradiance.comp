#version 450

#include "descriptors.glsl"
#include "numbers.glsl"
#include "octahedral.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

layout(push_constant) uniform Push_constants {
  layout(offset = 0) uint16_t depth_texture;
  layout(offset = 2) uint16_t previous_depth_texture;
  layout(offset = 4) uint16_t normal_texture;
  layout(offset = 6) uint16_t previous_normal_texture;
  layout(offset = 8) uint16_t indirect_radiance_texture;
  layout(offset = 10) uint16_t indirect_radiance_direction_texture;
  layout(offset = 12) uint16_t indirect_irradiance_image;
  layout(offset = 14) uint16_t previous_indirect_irradiance_texture;
  layout(offset = 16) uint16_t motion_vector_texture;
  layout(offset = 20) uint history_valid;
  layout(offset = 24) float z_near;
  layout(offset = 32, row_major) mat4x3 camera_basis;
  layout(offset = 80) vec2 zoom;
} push_constants;

const int neighborhood_width = 3;
const int sample_count = neighborhood_width * neighborhood_width;

// Center is sample 0. The remaining samples cover the neighborhood in
// row-major order, skipping the center element.
ivec2 sample_offset(int sample_index) {
  if (sample_index == 0) {
    return ivec2(0);
  }
  const int center_index = sample_count / 2;
  const int neighborhood_index =
    sample_index <= center_index ? sample_index - 1 : sample_index;
  return ivec2(
    neighborhood_index % neighborhood_width - neighborhood_width / 2,
    neighborhood_index / neighborhood_width - neighborhood_width / 2);
}

vec3 world_position(ivec2 pixel, ivec2 size, float depth) {
  const vec2 ndc = (vec2(pixel) + 0.5) / vec2(size) * 2.0 - 1.0;
  const vec3 view_ray = vec3(
    -ndc.x * push_constants.zoom.x, -ndc.y * push_constants.zoom.y, 1.0);
  const float view_z = push_constants.z_near / depth;
  return
    push_constants.camera_basis[3].xyz +
    mat3(push_constants.camera_basis) * (view_ray * view_z);
}

float surface_pdf(
    vec3 position,
    vec3 normal,
    vec3 hit_position,
    vec3 hit_normal) {
  const vec3 hit_displacement = hit_position - position;
  const float hit_distance_squared = dot(hit_displacement, hit_displacement);
  if (hit_distance_squared <= 0.0) {
    return 1.0 / 0.0;
  }
  const vec3 hit_direction = hit_displacement / sqrt(hit_distance_squared);
  const float angular_pdf = max(dot(normal, hit_direction), 0.0) / pi;
  return
    angular_pdf *
    abs(dot(hit_normal, hit_direction)) / hit_distance_squared;
}

float sampled_surface_pdf(
    vec3 normal,
    vec3 ray_direction,
    vec3 hit_normal,
    float hit_distance) {
  if (hit_distance <= 0.0) {
    return 1.0 / 0.0;
  }
  const float angular_pdf = max(dot(normal, ray_direction), 0.0) / pi;
  return
    angular_pdf *
    abs(dot(hit_normal, ray_direction)) / (hit_distance * hit_distance);
}

float balance_weight(float pdf, float other_pdf) {
  if (isinf(pdf)) {
    return isinf(other_pdf) ? 0.5 : 1.0;
  }
  if (isinf(other_pdf)) {
    return 0.0;
  }
  return pdf / (pdf + other_pdf);
}

void main() {
  const ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
  const ivec2 size =
    imageSize(storage_images[push_constants.indirect_irradiance_image]);
  if (pixel.x >= size.x || pixel.y >= size.y) {
    return;
  }
  vec3 irradiance = vec3(0.0);
  float accumulated_frames = 0.0;
  const float center_depth =
    texelFetch(sampled_images[push_constants.depth_texture], pixel, 0).r;
  if (center_depth != 0.0) {
    const vec3 center_position =
      world_position(pixel, size, center_depth);
    const vec3 center_normal =
      oct_decode(
        texelFetch(
          sampled_images[push_constants.normal_texture],
          pixel,
          0).rg);
    const vec4 center_ray_direction_and_hit_normal =
      texelFetch(
        sampled_images[push_constants.indirect_radiance_direction_texture],
        pixel,
        0);
    const vec3 center_ray_direction =
      oct_decode(center_ray_direction_and_hit_normal.rg);
    const vec3 center_hit_normal =
      oct_decode(center_ray_direction_and_hit_normal.ba);
    const vec4 center_radiance_and_distance =
      texelFetch(
        sampled_images[push_constants.indirect_radiance_texture],
        pixel,
        0);
    const vec3 center_hit_position =
      center_position +
      center_radiance_and_distance.a * center_ray_direction;
    const float center_pdf_at_center_hit =
      sampled_surface_pdf(
        center_normal,
        center_ray_direction,
        center_hit_normal,
        center_radiance_and_distance.a);
    // f(X_c) = center_radiance_and_distance.rgb * pi * center_pdf_at_center_hit,
    // so f(X_c) / p_c(X_c) reduces to center_radiance_and_distance.rgb * pi.
    const vec3 f_Xc_over_pc = center_radiance_and_distance.rgb * pi;
    int neighbor_count = 0;
    for (int j = 1; j < sample_count; ++j) {
      const ivec2 sample_pixel = pixel + sample_offset(j);
      const bool in_bounds =
        sample_pixel.x >= 0 && sample_pixel.y >= 0 &&
        sample_pixel.x < size.x && sample_pixel.y < size.y;
      if (!in_bounds) {
        continue;
      }
      const float depth = texelFetch(
          sampled_images[push_constants.depth_texture],
          sample_pixel,
          0).r;
      if (depth == 0.0) {
        continue;
      }
      ++neighbor_count;
    }
    const float n = float(neighbor_count);
    for (int j = 1; j < sample_count; ++j) {
      const ivec2 sample_pixel = pixel + sample_offset(j);
      const bool in_bounds =
        sample_pixel.x >= 0 && sample_pixel.y >= 0 &&
        sample_pixel.x < size.x && sample_pixel.y < size.y;
      if (!in_bounds) {
        continue;
      }
      const float depth = texelFetch(
          sampled_images[push_constants.depth_texture],
          sample_pixel,
          0).r;
      if (depth == 0.0) {
        continue;
      }
      const vec3 position = world_position(sample_pixel, size, depth);
      const vec3 normal = oct_decode(
        texelFetch(
          sampled_images[push_constants.normal_texture],
          sample_pixel,
          0).rg);
      const vec4 ray_direction_and_hit_normal =
        texelFetch(
          sampled_images[push_constants.indirect_radiance_direction_texture],
          sample_pixel,
          0);
      const vec3 ray_direction =
        oct_decode(ray_direction_and_hit_normal.rg);
      const vec3 hit_normal =
        oct_decode(ray_direction_and_hit_normal.ba);
      const vec4 radiance_and_distance = texelFetch(
        sampled_images[push_constants.indirect_radiance_texture],
        sample_pixel,
        0);
      const vec3 hit_position =
        position + radiance_and_distance.a * ray_direction;
      const float neighbor_pdf_at_center_hit =
        surface_pdf(
          position,
          normal,
          center_hit_position,
          center_hit_normal);
      const float center_pdf_at_neighbor_hit =
        surface_pdf(
          center_position,
          center_normal,
          hit_position,
          hit_normal);
      const float neighbor_pdf_at_neighbor_hit =
        sampled_surface_pdf(
          normal,
          ray_direction,
          hit_normal,
          radiance_and_distance.a);
      const float m_c =
        (1.0 / n) *
        balance_weight(
          center_pdf_at_center_hit,
          n * neighbor_pdf_at_center_hit);
      const float m_i =
        (1.0 / n) *
        balance_weight(
          n * neighbor_pdf_at_neighbor_hit,
          center_pdf_at_neighbor_hit);
      // f(X_i), the shared target function evaluated at the neighbor's hit
      // point using center's geometry, divided by the neighbor's own pdf.
      const vec3 f_Xi_over_pi = 
        radiance_and_distance.rgb * pi * center_pdf_at_neighbor_hit /
        neighbor_pdf_at_neighbor_hit;
      irradiance += m_c * f_Xc_over_pc + m_i * f_Xi_over_pi;
    }
    if (neighbor_count == 0) {
      irradiance = pi * center_radiance_and_distance.rgb;
    }
    // Temporal accumulation
    if (push_constants.history_valid != 0) {
      const vec2 uv = (vec2(pixel) + 0.5) / vec2(size);
      const vec3 motion_vector_and_previous_depth =
        texelFetch(
          sampled_images[push_constants.motion_vector_texture],
          pixel,
          0).rgb;
      const vec2 previous_uv =
        uv + motion_vector_and_previous_depth.xy;
      if (all(greaterThanEqual(previous_uv, vec2(0.0))) &&
          all(lessThanEqual(previous_uv, vec2(1.0)))) {
        const vec4 history = texture(
          sampled_images
            [push_constants.previous_indirect_irradiance_texture],
          previous_uv);
        const vec3 history_irradiance = history.rgb;
        const float history_accumulated_frames = history.a;
        const float history_depth =
          texture(
            sampled_images[push_constants.previous_depth_texture],
            previous_uv).r;
        const float zn = push_constants.z_near;
        const float previous_linear_depth =
          zn / motion_vector_and_previous_depth.z;
        const float history_linear_depth = zn / history_depth;
        const float depth_weight =
          exp(-abs(previous_linear_depth - history_linear_depth));
        const vec3 history_normal =
          oct_decode(
            texture(
              sampled_images[push_constants.previous_normal_texture],
              previous_uv).rg);
        const float normal_weight =
          pow(max(dot(center_normal, history_normal), 0.0), 32.0);
        const float accumulation_weight =
          min(
            history_accumulated_frames / (history_accumulated_frames + 1.0),
            15.0 / 16.0);
        const float edge_weight = depth_weight * normal_weight;
        const float gamma = edge_weight * accumulation_weight;
        irradiance = mix(irradiance, history_irradiance, gamma);
        accumulated_frames = edge_weight * history_accumulated_frames + 1.0;
      }
    } else {
      accumulated_frames = 1.0;
    }
  }
  imageStore(
    storage_images[push_constants.indirect_irradiance_image],
    pixel,
    vec4(irradiance, accumulated_frames));
}
