#version 450

#include "color.glsl"
#include "descriptors.glsl"
#include "direct_spatial_filter.glsl"
#include "gbuffer.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

// One iteration of the 3x3 a-trous edge-aware filter on the direct
// irradiance color, combining the depth/normal/luminance edge-stopping
// weights (direct_spatial_filter.glsl) with the standard
// a-trous kernel. The depth and luminance weights are both exp(-x), so
// their exponents are summed and exponentiated once per tap.
// Also propagates variance for the next iteration's luminance_weight
// tolerance, reusing this iteration's own per-tap h(q)*w(p,q) weight:
// Var(c_{i+1}(p)) = sum(h(q)*w(p,q))^2 * Var(c_i(q)) / (sum(h(q)*w(p,q)))^2.
// Dispatched once per iteration with different textures/step_size rather
// than duplicated -- nothing about the logic differs between iterations.
layout(push_constant) uniform Push_constants {
  layout(offset = 0) uint16_t depth_texture;
  layout(offset = 2) uint16_t normal_texture;
  layout(offset = 4) uint16_t gradient_texture;
  layout(offset = 6) uint16_t direct_irradiance_texture;
  layout(offset = 8) uint16_t direct_variance_texture;
  layout(offset = 10) uint16_t direct_irradiance_filtered_image;
  layout(offset = 12) uint16_t direct_variance_image;
  layout(offset = 16) uint step_size;
  layout(offset = 20) float z_near;
} push_constants;

// The 3-tap a-trous kernel {1, 2, 1} / 4, as a formula in |d| rather than
// an array lookup. Exact at d = 0 and 1 (both terms are powers of two),
// and register-only: indexing a const array from a loop the compiler does
// not unroll puts it in function-local storage.
float kernel_1d(int d) {
  return (2.0 - float(abs(d))) * (1.0 / 4.0);
}

void main() {
  const ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
  const ivec2 size = imageSize(
    storage_images[push_constants.direct_irradiance_filtered_image]);
  if (pixel.x >= size.x || pixel.y >= size.y) {
    return;
  }
  const Gbuffer_sample gp = gbuffer_decode(
    texelFetch(sampled_images[push_constants.depth_texture], pixel, 0).x,
    push_constants.z_near,
    texelFetch(sampled_images[push_constants.normal_texture], pixel, 0).xy,
    texelFetch(sampled_images[push_constants.gradient_texture], pixel, 0).x);
  if (gp.linear_depth == 0.0) {
    imageStore(
      storage_images[push_constants.direct_irradiance_filtered_image],
      pixel,
      vec4(0.0));
    imageStore(
      storage_images[push_constants.direct_variance_image],
      pixel,
      vec4(0.0));
    return;
  }
  const vec3 n_p = gp.normal;
  const float depth_p = gp.linear_depth;
  const vec3 color_p = texelFetch(
    sampled_images[push_constants.direct_irradiance_texture], pixel, 0).rgb;
  const float l_p = luminance(color_p);
  const float variance_p = texelFetch(
    sampled_images[push_constants.direct_variance_texture],
    pixel,
    0).r;
  // Everything depending only on p, lifted out of the tap loop.
  const float sigma_gradient_z_p = depth_weight_sigma_z * gp.gradient;
  const float luminance_rcp_scale = luminance_weight_rcp_scale(variance_p);

  const ivec2 max_coord = size - ivec2(1);
  const int step_size = int(push_constants.step_size);
  vec3 color_numerator = vec3(0.0);
  float weight_sum = 0.0;
  float variance_numerator = 0.0;
  for (int dy = -1; dy <= 1; ++dy) {
    const float kernel_y = kernel_1d(dy);
    for (int dx = -1; dx <= 1; ++dx) {
      const ivec2 coord =
        clamp(pixel + ivec2(dx, dy) * step_size, ivec2(0), max_coord);
      const Gbuffer_sample gq = gbuffer_decode(
        texelFetch(sampled_images[push_constants.depth_texture], coord, 0).x,
        push_constants.z_near,
        texelFetch(sampled_images[push_constants.normal_texture], coord, 0).xy,
        0.0);
      if (gq.linear_depth == 0.0) {
        continue;
      }
      const vec3 n_q = gq.normal;
      const float depth_q = gq.linear_depth;
      const vec3 color_q = texelFetch(
        sampled_images[push_constants.direct_irradiance_texture],
        coord,
        0).rgb;
      const float l_q = luminance(color_q);
      const float depth_rcp_scale = depth_weight_rcp_scale(
        sigma_gradient_z_p, length(vec2(coord - pixel)));
      const float exponent =
        depth_weight_exponent(depth_p, depth_q, depth_rcp_scale) +
        luminance_weight_exponent(l_p, l_q, luminance_rcp_scale);
      const float weight =
        kernel_1d(dx) * kernel_y *
        exp(-exponent) *
        normal_weight(n_p, n_q);
      const float variance_q = texelFetch(
        sampled_images[push_constants.direct_variance_texture],
        coord,
        0).r;
      color_numerator += weight * color_q;
      weight_sum += weight;
      variance_numerator += weight * weight * variance_q;
    }
  }
  imageStore(
    storage_images[push_constants.direct_irradiance_filtered_image],
    pixel,
    vec4(color_numerator / weight_sum, 1.0));
  imageStore(
    storage_images[push_constants.direct_variance_image],
    pixel,
    vec4(variance_numerator / (weight_sum * weight_sum), 0.0, 0.0, 0.0));
}
