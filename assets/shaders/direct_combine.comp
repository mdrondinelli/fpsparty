#version 450

#include "direct_common.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

// Rebuilds both samples' directions and densities per pixel and does the
// MIS division the traces skipped. Everything it needs is either in the
// G-buffer or recomputed from the same helpers sample generation used, so
// only the random variables are stored between them.
//
// Recomputing rather than storing is also what keeps the weights summing
// to one: where the environment was not worth a ray, this knows it and
// drops that density instead of dividing by a stale one.
layout(push_constant) uniform Push_constants {
  layout(offset = 0) Scene scene;
  layout(offset = 8) uint16_t depth_texture;
  layout(offset = 10) uint16_t normal_texture;
  layout(offset = 12) uint16_t transmittance_texture;
  layout(offset = 14) uint16_t environment_uv_image;
  layout(offset = 16) uint16_t brdf_uv_image;
  layout(offset = 18) uint16_t environment_numerator_image;
  layout(offset = 20) uint16_t brdf_numerator_image;
  layout(offset = 22) uint16_t direct_irradiance_image;
  layout(offset = 24) Sky_irradiance sky_irradiance;
  layout(offset = 32) uint seed;
} push_constants;

void main() {
  const ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
  const ivec2 size =
    imageSize(storage_images[push_constants.direct_irradiance_image]);
  if (pixel.x >= size.x || pixel.y >= size.y) {
    return;
  }
  if (texelFetch(sampled_images[push_constants.depth_texture], pixel, 0).x ==
      0.0) {
    imageStore(
      storage_images[push_constants.direct_irradiance_image],
      pixel,
      vec4(0.0));
    return;
  }
  const Direct_shading_point shading_point =
    direct_shading_point(
      push_constants.scene,
      push_constants.depth_texture,
      push_constants.normal_texture,
      pixel,
      size);
  const vec3 n = shading_point.normal;
  const vec3 sun_direction = push_constants.scene.sun_direction;
  const uint pixel_index = uint(pixel.y) * uint(size.x) + uint(pixel.x);
  const Direct_environment_weight weight = direct_environment_weight(
    push_constants.scene,
    n,
    shading_point.position.y,
    push_constants.transmittance_texture,
    push_constants.sky_irradiance);
  const Direct_draw draw =
    direct_draw(pixel_index, push_constants.seed, weight.p_cone);
  vec3 E = vec3(0.0);
  if (weight.valid) {
    const vec3 w_e = direct_environment_direction(
      draw.is_cone,
      n,
      sun_direction,
      direct_load_uv(push_constants.environment_uv_image, pixel));
    const float cos_e = max(dot(n, w_e), 0.0);
    if (cos_e > 0.0) {
      // Cone samples are inside by construction; rechecking the rotated
      // direction can round outside the disc and drop both the sun and the
      // lobe that drew it.
      const bool in_sun_disc =
        draw.is_cone || direct_in_sun_disc(w_e, sun_direction);
      E += imageLoad(
             storage_images[push_constants.environment_numerator_image],
             pixel).rgb /
        (direct_environment_pdf(weight.p_cone, cos_e, in_sun_disc) +
         direct_brdf_pdf(cos_e));
    }
  }
  const vec3 w_b = direct_brdf_direction(
    n, direct_load_uv(push_constants.brdf_uv_image, pixel));
  const float cos_b = max(dot(n, w_b), 0.0);
  if (cos_b > 0.0) {
    const vec4 brdf_numerator =
      imageLoad(storage_images[push_constants.brdf_numerator_image], pixel);
    // The environment's density counts only where the environment is what
    // the ray reached, and only where it was sampled at all.
    const float environment_pdf = (weight.valid && brdf_numerator.a > 0.0)
      ? direct_environment_pdf(
          weight.p_cone, cos_b, direct_in_sun_disc(w_b, sun_direction))
      : 0.0;
    E += brdf_numerator.rgb / (environment_pdf + direct_brdf_pdf(cos_b));
  }
  imageStore(
    storage_images[push_constants.direct_irradiance_image], pixel, vec4(E, 1.0));
}
