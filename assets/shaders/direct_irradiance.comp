#version 450

#include "atmosphere/sky_irradiance.glsl"
#include "direct_irradiance_common.glsl"
#include "octahedral.glsl"
#include "random.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

// Pass 1 of 2 (direct_irradiance_trace_sun.comp / direct_irradiance_trace_
// sky.comp are pass 2, one dispatch per technique). Splits sample
// generation from tracing: this pass only picks a technique (sun vs sky,
// importance-sampled by unshadowed irradiance as before) and a direction
// per pixel, and appends it to that technique's own buffer via atomicAdd --
// no ray tracing happens here at all. Sorting into two buffers up front is
// what lets pass 2 run as two uniform-technique dispatches: a tiny cone
// around one fixed global direction (sun) is far more ray-coherent than
// cosine-sampled sky, which spans the whole hemisphere differently at every
// pixel, and neither dispatch has to branch on technique anymore.
layout(push_constant) uniform Push_constants {
  layout(offset = 0) Scene scene;
  layout(offset = 8) uint16_t normal_texture;
  layout(offset = 10) uint16_t depth_texture;
  layout(offset = 12) uint16_t transmittance_texture;
  layout(offset = 14) uint16_t sky_view_lut;
  layout(offset = 16) Sky_irradiance sky_irradiance;
  layout(offset = 24) Distant_light_samples sun_samples;
  layout(offset = 32) Distant_light_samples sky_samples;
  layout(offset = 40) uint seed;
} push_constants;

// Batches this workgroup's samples through groupshared memory instead of
// hitting push_constants.{sun,sky}_samples.count with one global atomicAdd
// per invocation: every invocation first bumps a groupshared per-type
// counter, invocation 0 reserves this workgroup's whole span with a single
// global atomicAdd per type (turning up to 64 global atomics into at most
// 2), then every invocation bumps that same groupshared variable again --
// now holding the reserved global base -- to claim its own unique global
// slot. Three barriers mark the phase changes (init -> count -> reserve ->
// write); all of them must be reached by every invocation in the workgroup,
// which is why pixel/depth validity below is carried as a bool instead of
// an early return (a divergent return before a barrier is not
// workgroup-uniform control flow).
shared uint sun_offset;
shared uint sky_offset;

void main() {
  const ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
  const ivec2 size =
    textureSize(sampled_images[push_constants.depth_texture], 0);
  const uint pixel_index = uint(pixel.y) * uint(size.x) + uint(pixel.x);
  bool valid = pixel.x < size.x && pixel.y < size.y;
  bool is_sun = false;
  vec2 uv = vec2(0.0);
  if (valid) {
    const float depth =
      texelFetch(sampled_images[push_constants.depth_texture], pixel, 0).r;
    valid = depth != 0.0;
    if (valid) {
      const vec2 ndc = (vec2(pixel) + 0.5) / vec2(size) * 2.0 - 1.0;
      const vec3 view_ray = vec3(
        -ndc.x * push_constants.scene.zoom.x,
        -ndc.y * push_constants.scene.zoom.y,
        1.0);
      const vec3 camera_position = push_constants.scene.camera_basis[3].xyz;
      const float view_z = push_constants.scene.z_near / depth;
      const vec3 world_position =
        camera_position +
        mat3(push_constants.scene.camera_basis) * (view_ray * view_z);
      const vec3 n = oct_decode(
        texelFetch(
          sampled_images[push_constants.normal_texture], pixel, 0).rg);
      const vec3 sun_direction = push_constants.scene.sun_direction;
      const vec3 sun_transmittance =
        transmittance_along_ray(
          push_constants.transmittance_texture,
          vec3(0.0, r_ground + world_position.y, 0.0),
          sun_direction);
      const vec3 unshadowed_sun =
        eval_f_true_sun(
          sun_direction,
          n,
          sun_transmittance,
          push_constants.scene) *
        sun_solid_angle;
      const vec3 unshadowed_sky =
        sample_sky_irradiance(push_constants.sky_irradiance, n);
      const float l_sun = luminance(unshadowed_sun);
      const float l_sky = luminance(unshadowed_sky);
      const float total = l_sun + l_sky;
      const float p_sun = total > 0.0 ? l_sun / total : 0.5;
      Random random;
      random.state = lowbias32(pixel_index) ^ lowbias32(push_constants.seed);
      is_sun = random_float(random) < p_sun;
      uv = vec2(random_float(random), random_float(random));
    }
  }
  if (gl_LocalInvocationIndex == 0u) {
    sun_offset = 0u;
    sky_offset = 0u;
  }
  barrier();
  if (valid) {
    if (is_sun) {
      atomicAdd(sun_offset, 1u);
    } else {
      atomicAdd(sky_offset, 1u);
    }
  }
  barrier();
  if (gl_LocalInvocationIndex == 0u) {
    sun_offset = atomicAdd(push_constants.sun_samples.count, sun_offset);
    sky_offset = atomicAdd(push_constants.sky_samples.count, sky_offset);
  }
  barrier();
  if (valid) {
    if (is_sun) {
      const uint slot = atomicAdd(sun_offset, 1u);
      push_constants.sun_samples.samples[slot].uv = packUnorm2x16(uv);
      push_constants.sun_samples.samples[slot].pixel = pixel_index;
    } else {
      const uint slot = atomicAdd(sky_offset, 1u);
      push_constants.sky_samples.samples[slot].uv = packUnorm2x16(uv);
      push_constants.sky_samples.samples[slot].pixel = pixel_index;
    }
  }
}
