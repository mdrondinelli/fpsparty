#version 450

#include "direct_irradiance_common.glsl"
#include "octahedral.glsl"
#include "random.glsl"
#include "rt.glsl"
#include "sampling.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

// Pass 1 of 2 (direct_irradiance_shade.comp is pass 2). M fresh sun-cone
// candidates per pixel, combined via RIS into one selected sample -- no
// cross-pixel/cross-frame reuse yet, just this pixel's own M draws. Every
// candidate is drawn from the identical cone distribution (same fixed
// global sun_direction), so the balance heuristic's m_i = p_i(x)/sum(p_j(x))
// collapses to a plain 1/M, and p_gen(x_i) = 1/sun_solid_angle is the same
// constant for all of them -- see the loop below for where that shows up.
// p_hat(x_i) is the true (visibility-inclusive) integrand, so every
// candidate needs its own trace: M rays per pixel here (M is a constant
// below, currently 2), not one.
//
// Stores the *chosen* sample's square coords (u,v) packed into a
// r32_uint (12 bits per axis, 8 spare/reserved) -- oct-encoding a 3D
// direction would waste nearly all its resolution outside the sun's tiny
// cone, whereas (u,v) maps directly onto it. Also stores the reservoir's
// final unbiased weight W_y into a separate r16_sfloat texture. No
// visibility flag is stored anywhere: if the chosen candidate was
// occluded, p_hat(chosen) = 0, which forces W_y = 0 by construction (see
// the guard below) -- pass 2 can multiply by W_y blindly and get the
// right answer (zero) without needing to know why.
//
// Written and read via storage_uimages/storage_images (imageLoad/
// imageStore), not a sampled descriptor -- there's no uint-sampled
// bindless array in this codebase (only sampler2D), and imageLoad was
// conclusively cleared as a hang suspect earlier this session (the real
// cause was an unrelated divergent-branch pattern), so there's no reason
// to avoid it here.
layout(push_constant) uniform Push_constants {
  layout(offset = 0) Scene scene;
  layout(offset = 8) uint16_t normal_texture;
  layout(offset = 10) uint16_t depth_texture;
  layout(offset = 12) uint16_t transmittance_texture;
  layout(offset = 14) uint16_t sample_image;
  layout(offset = 16) uint16_t weight_image;
  layout(offset = 24) Rt_block_grid rt_block_grid;
  layout(offset = 32) Rt_entities entities;
  layout(offset = 40) Rt_entity_grid entity_grid;
  layout(offset = 48) Rt_entity_nodes entity_nodes;
  layout(offset = 56) uint seed;
} push_constants;

const int M = 2;

void main() {
  const ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
  const ivec2 size = imageSize(storage_uimages[push_constants.sample_image]);
  if (pixel.x >= size.x || pixel.y >= size.y) {
    return;
  }
  const float depth =
    texelFetch(sampled_images[push_constants.depth_texture], pixel, 0).r;
  if (depth == 0.0) {
    return;
  }
  const vec2 ndc = (vec2(pixel) + 0.5) / vec2(size) * 2.0 - 1.0;
  const vec3 view_ray = vec3(
    -ndc.x * push_constants.scene.zoom.x,
    -ndc.y * push_constants.scene.zoom.y,
    1.0);
  const vec3 camera_position = push_constants.scene.camera_basis[3].xyz;
  const float view_z = push_constants.scene.z_near / depth;
  const vec3 world_position =
    camera_position +
    mat3(push_constants.scene.camera_basis) * (view_ray * view_z);
  const vec3 n = oct_decode(
    texelFetch(
      sampled_images[push_constants.normal_texture], pixel, 0).rg);
  const vec3 sun_direction = push_constants.scene.sun_direction;
  const vec3 sun_transmittance =
    transmittance_along_ray(
      push_constants.transmittance_texture,
      vec3(0.0, r_ground + world_position.y, 0.0),
      sun_direction);
  const vec3 ray_origin = offset_ray_origin(world_position, n);

  Random random;
  const uint pixel_index = uint(pixel.y) * uint(size.x) + uint(pixel.x);
  random.state = lowbias32(pixel_index ^ lowbias32(push_constants.seed));

  vec2 chosen_uv = vec2(0.0);
  vec3 chosen_f = vec3(0.0);
  float w_sum = 0.0;
  for (int i = 0; i < M; ++i) {
    const vec2 uv = vec2(random_float(random), random_float(random));
    const vec3 dir =
      make_basis(sun_direction) * square_to_cone(uv, cos_sun_angular_radius);
    const bool occluded = trace_ray(
      push_constants.rt_block_grid,
      push_constants.entities,
      push_constants.entity_grid,
      push_constants.entity_nodes,
      ray_origin,
      dir,
      true);
    const vec3 f =
      eval_f_true_sun(dir, n, sun_transmittance, push_constants.scene) *
      (occluded ? 0.0 : 1.0);
    const float p_hat = luminance(f);
    // pdf = 1/sun_solid_angle, so w_i = p_hat/p_gen = p_hat*sun_solid_angle.
    const float w = (1.0 / M) * p_hat * sun_solid_angle;
    w_sum += w;
    const bool select = random_float(random) * w_sum < w;
    chosen_uv = select ? uv : chosen_uv;
    chosen_f = select ? f : chosen_f;
  }
  const float chosen_p_hat = luminance(chosen_f);
  const float W_y = chosen_p_hat > 0.0 ? w_sum / chosen_p_hat : 0.0;
  const uint u_bits = uint(clamp(chosen_uv.x, 0.0, 1.0) * 4095.0 + 0.5);
  const uint v_bits = uint(clamp(chosen_uv.y, 0.0, 1.0) * 4095.0 + 0.5);
  const uint packed = u_bits | (v_bits << 12);
  imageStore(
    storage_uimages[push_constants.sample_image], pixel, uvec4(packed));
  imageStore(
    storage_images[push_constants.weight_image],
    pixel,
    vec4(sanitize(W_y, 0.0)));
}
