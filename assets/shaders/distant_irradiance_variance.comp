#version 450

#include "descriptors.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

// Runs after distant_irradiance_trace_sun.comp / distant_irradiance_trace_
// sky.comp (temporal accumulation done): reads this frame's luminance
// moments, blurs them with a 3x3 (1,2,1) gaussian, then derives variance
// from the blurred moments. No edge-stopping weights -- just a plain
// separable gaussian -- implemented as the standard 4-tap optimization:
// sampling at the 4 texel-corner midpoints (+-0.5, +-0.5) with a linear-
// filtering sampler makes the GPU's own bilinear interpolation do the
// (1,2,1)x(1,2,1)/16 weighting, so 4 texture() taps replace the naive 9
// texelFetch taps.
layout(push_constant) uniform Push_constants {
  layout(offset = 0) uint16_t depth_texture;
  layout(offset = 2) uint16_t distant_irradiance_luminance_texture;
  layout(offset = 4) uint16_t distant_irradiance_variance_image;
} push_constants;

void main() {
  const ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
  const ivec2 size = imageSize(
    storage_images[push_constants.distant_irradiance_variance_image]);
  if (pixel.x >= size.x || pixel.y >= size.y) {
    return;
  }
  // A pixel with no geometry (depth == 0, e.g. sky) never had its luminance
  // moments written this frame -- distant_irradiance.comp skips those
  // pixels entirely -- so the texture holds stale/unrelated data there.
  const float depth = texelFetch(
    sampled_images[push_constants.depth_texture], pixel, 0).x;
  if (depth == 0.0) {
    imageStore(
      storage_images[push_constants.distant_irradiance_variance_image],
      pixel,
      vec4(0.0));
    return;
  }
  const vec2 texel_size = 1.0 / vec2(size);
  const vec2 center = (vec2(pixel) + 0.5) * texel_size;
  vec2 moments = vec2(0.0);
  for (int i = 0; i < 4; ++i) {
    const vec2 corner = vec2(
      (i & 1) == 0 ? -0.5 : 0.5, (i & 2) == 0 ? -0.5 : 0.5) * texel_size;
    moments += 0.25 * texture(
      sampler2D(
        sampled_images[push_constants.distant_irradiance_luminance_texture],
        SAMPLER_LINEAR_CLAMP),
      center + corner).rg;
  }
  const float variance = max(moments.y - moments.x * moments.x, 0.0);
  imageStore(
    storage_images[push_constants.distant_irradiance_variance_image],
    pixel,
    vec4(variance, 0.0, 0.0, 0.0));
}
