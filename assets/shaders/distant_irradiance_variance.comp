#version 450

#include "descriptors.glsl"
#include "distant_irradiance_spatial_filter.glsl"
#include "octahedral.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

// Runs after distant_irradiance_trace_sun.comp / distant_irradiance_trace_
// sky.comp (temporal accumulation done): reads this frame's luminance
// moments, derives per-pixel variance, and blurs it with a 5x5 gaussian
// (separable 1,4,6,4,1 binomial weights, same kernel as distant_irradiance_
// spatial_filter.comp's a-trous filter), weighted by the same depth/normal
// edge-stopping functions the a-trous filter uses, before writing out.
layout(push_constant) uniform Push_constants {
  layout(offset = 0) uint16_t depth_texture;
  layout(offset = 2) uint16_t normal_texture;
  layout(offset = 4) uint16_t depth_gradient_texture;
  layout(offset = 6) uint16_t distant_irradiance_luminance_texture;
  layout(offset = 8) uint16_t distant_irradiance_variance_image;
} push_constants;

const float gaussian_weights[5] =
  float[5](1.0 / 16.0, 4.0 / 16.0, 6.0 / 16.0, 4.0 / 16.0, 1.0 / 16.0);

float variance_at(ivec2 coord) {
  const vec2 moments = texelFetch(
    sampled_images[push_constants.distant_irradiance_luminance_texture],
    coord,
    0).rg;
  return max(moments.y - moments.x * moments.x, 0.0);
}

void main() {
  const ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
  const ivec2 size = imageSize(
    storage_images[push_constants.distant_irradiance_variance_image]);
  if (pixel.x >= size.x || pixel.y >= size.y) {
    return;
  }
  // A tap with no geometry (depth == 0, e.g. sky) never had its luminance
  // moments written this frame -- distant_irradiance.comp skips those
  // pixels entirely -- so the texture holds stale/unrelated data there.
  // Skip such taps and redistribute their weight among the rest, same as
  // apply_distant_irradiance_history's per-tap rejection.
  const float center_depth =
    texelFetch(sampled_images[push_constants.depth_texture], pixel, 0).r;
  if (center_depth == 0.0) {
    imageStore(
      storage_images[push_constants.distant_irradiance_variance_image],
      pixel,
      vec4(0.0));
    return;
  }
  const vec3 n_p = oct_decode(
    texelFetch(sampled_images[push_constants.normal_texture], pixel, 0).rg);
  const vec2 gradient_z_p = texelFetch(
    sampled_images[push_constants.depth_gradient_texture], pixel, 0).rg;
  const ivec2 max_coord = size - ivec2(1);
  float weight_sum = 0.0;
  float result = 0.0;
  for (int dy = -2; dy <= 2; ++dy) {
    for (int dx = -2; dx <= 2; ++dx) {
      const ivec2 coord = clamp(pixel + ivec2(dx, dy), ivec2(0), max_coord);
      const float depth =
        texelFetch(sampled_images[push_constants.depth_texture], coord, 0).r;
      if (depth == 0.0) {
        continue;
      }
      const vec3 n_q = oct_decode(
        texelFetch(sampled_images[push_constants.normal_texture], coord, 0)
          .rg);
      const float weight =
        gaussian_weights[dx + 2] * gaussian_weights[dy + 2] *
        depth_weight(vec2(pixel), vec2(coord), center_depth, depth, gradient_z_p) *
        normal_weight(n_p, n_q);
      weight_sum += weight;
      result += weight * variance_at(coord);
    }
  }
  imageStore(
    storage_images[push_constants.distant_irradiance_variance_image],
    pixel,
    vec4(result / weight_sum, 0.0, 0.0, 0.0));
}
