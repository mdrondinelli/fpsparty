#version 450

#include "direct_common.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

// Writes the per-pixel payload and bins the environment ray. Only the
// random variables are handed forward; p_cone and the lobe choice are
// recomputed by whoever needs them, so nothing here has to stay in sync
// with the traces except through direct_common.glsl.
//
// The BRDF ray needs no queue: it is unconditional over surface pixels
// and its directions are incoherent anyway.
layout(push_constant) uniform Push_constants {
  layout(offset = 0) Scene scene;
  layout(offset = 8) uint16_t depth_texture;
  layout(offset = 10) uint16_t normal_texture;
  layout(offset = 12) uint16_t transmittance_texture;
  layout(offset = 14) uint16_t environment_uv_image;
  layout(offset = 16) uint16_t brdf_uv_image;
  // offset 18: 6 bytes unused (buffer references need 8-byte alignment).
  layout(offset = 24) Sky_irradiance sky_irradiance;
  layout(offset = 32) Direct_queue sun_queue;
  layout(offset = 40) Direct_queue sky_queue;
  layout(offset = 48) uint seed;
} push_constants;

shared uint sun_offset;
shared uint sky_offset;

void main() {
  const ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
  const ivec2 size =
    textureSize(sampled_images[push_constants.depth_texture], 0);
  const uint pixel_index = uint(pixel.y) * uint(size.x) + uint(pixel.x);
  bool valid = pixel.x < size.x && pixel.y < size.y;
  if (valid) {
    valid =
      texelFetch(sampled_images[push_constants.depth_texture], pixel, 0).x !=
      0.0;
  }
  bool is_cone = false;
  bool sample_environment = false;
  if (valid) {
    const Direct_shading_point shading_point =
      direct_shading_point(
        push_constants.scene,
        push_constants.depth_texture,
        push_constants.normal_texture,
        pixel,
        size);
    const Direct_environment_weight weight = direct_environment_weight(
      push_constants.scene,
      shading_point.normal,
      shading_point.position.y,
      push_constants.transmittance_texture,
      push_constants.sky_irradiance);
    const Direct_draw draw =
      direct_draw(pixel_index, push_constants.seed, weight.p_cone);
    direct_store_uv(
      push_constants.environment_uv_image, pixel, draw.environment_uv);
    direct_store_uv(push_constants.brdf_uv_image, pixel, draw.brdf_uv);
    is_cone = draw.is_cone;
    // A black environment is worth no ray, but the pixel still gets its
    // BRDF ray, and the combination recomputes this rather than reading a
    // flag.
    sample_environment = weight.valid;
  }
  if (gl_LocalInvocationIndex == 0u) {
    sun_offset = 0u;
    sky_offset = 0u;
  }
  barrier();
  if (sample_environment) {
    if (is_cone) {
      atomicAdd(sun_offset, 1u);
    } else {
      atomicAdd(sky_offset, 1u);
    }
  }
  barrier();
  if (gl_LocalInvocationIndex == 0u) {
    sun_offset = atomicAdd(push_constants.sun_queue.count, sun_offset);
    sky_offset = atomicAdd(push_constants.sky_queue.count, sky_offset);
  }
  barrier();
  if (sample_environment) {
    if (is_cone) {
      push_constants.sun_queue.pixels[atomicAdd(sun_offset, 1u)] = pixel_index;
    } else {
      push_constants.sky_queue.pixels[atomicAdd(sky_offset, 1u)] = pixel_index;
    }
  }
}
