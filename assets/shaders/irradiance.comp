#version 450

#include "descriptors.glsl"
#include "octahedral.glsl"
#include "random.glsl"
#include "scene.glsl"
#include "rt_grid.glsl"
#include "atmosphere/atmosphere.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

const float bounce_albedo = 0.3;

layout(push_constant) uniform Push_constants {
  layout(offset = 0) mat4 camera_basis;
  layout(offset = 64) vec2 zoom;
  layout(offset = 72) float z_near;
  layout(offset = 76) uint normal_texture;
  layout(offset = 80) uint depth_texture;
  layout(offset = 84) uint sky_view_lut;
  layout(offset = 88) uint irradiance_image;
  layout(offset = 92) uint rng_state_image;
  layout(offset = 96) Rt_grid rt_grid;
  layout(offset = 104) Scene scene;
} push_constants;

mat3 basis_from_normal(vec3 n) {
  const vec3 helper =
    abs(n.x) < abs(n.y) ? vec3(1.0, 0.0, 0.0) : vec3(0.0, 1.0, 0.0);
  const vec3 tangent = normalize(cross(helper, n));
  const vec3 bitangent = cross(n, tangent);
  return mat3(tangent, bitangent, n);
}

vec3 cosine_sample_hemisphere(vec2 u) {
  const float r = sqrt(u.x);
  const float theta = 2.0 * pi * u.y;
  return vec3(r * cos(theta), r * sin(theta), sqrt(max(0.0, 1.0 - u.x)));
}

vec2 sky_view_texcoord(vec3 rd, float altitude) {
  const vec3 horizontal = vec3(rd.x, 0.0, rd.z);
  float longitude = 0.0;
  const float len = length(horizontal);
  if (len >= 1.0e-6) {
    const vec3 normalized_horizontal = horizontal / len;
    longitude = atan(normalized_horizontal.z, normalized_horizontal.x);
  }
  const float zenith = acos(clamp(rd.y, -1.0, 1.0));
  return pack_sky_view_lut_params(longitude, altitude, zenith);
}

void main() {
  const ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
  const ivec2 size =
    imageSize(storage_images[push_constants.irradiance_image]);
  if (pixel.x >= size.x || pixel.y >= size.y) {
    return;
  }
  const float depth =
    texelFetch(sampled_images[push_constants.depth_texture], pixel, 0).r;
  if (depth == 0.0) {
    return;
  }
  const vec2 ndc = (vec2(pixel) + 0.5) / vec2(size) * 2.0 - 1.0;
  const vec3 view_ray = vec3(
    -ndc.x * push_constants.zoom.x, -ndc.y * push_constants.zoom.y, 1.0);
  const vec3 camera_position = push_constants.camera_basis[3].xyz;
  const float view_z = push_constants.z_near / depth;
  const vec3 world_position =
    camera_position + mat3(push_constants.camera_basis) * (view_ray * view_z);
  const vec2 oct =
    texelFetch(sampled_images[push_constants.normal_texture], pixel, 0).rg;
  const vec3 n = oct_decode(oct);
  const mat3 basis = basis_from_normal(n);
  Random random;
  random.state = imageLoad(
    storage_uimages[push_constants.rng_state_image], pixel).x;
  const vec2 u = vec2(random_float(random), random_float(random));
  const vec3 dir = basis * cosine_sample_hemisphere(u);
  const vec3 ray_origin = offset_ray_origin(world_position, n);
  Rt_grid_hit hit;
  vec3 irradiance;
  if (rt_grid_trace(push_constants.rt_grid, ray_origin, dir, hit)) {
    // next event estimation: one bounce of sunlight off the hit surface
    const vec3 sun_direction = push_constants.scene.sun_direction;
    const vec3 hit_position = ray_origin + hit.t * dir;
    const bool sun_occluded = rt_grid_trace(
      push_constants.rt_grid,
      offset_ray_origin(hit_position, hit.normal),
      sun_direction);
    if (sun_occluded) {
      irradiance = vec3(0.0);
    } else {
      const vec3 E_sun =
        push_constants.scene.sun_irradiance *
        transmittance_along_ray(
          push_constants.scene,
          vec3(0.0, r_ground + hit_position.y, 0.0),
          sun_direction);
      irradiance =
        bounce_albedo * E_sun * max(dot(hit.normal, sun_direction), 0.0);
    }
  } else {
    irradiance = pi * FPSPARTY_SAMPLE(
      push_constants.sky_view_lut,
      sky_view_texcoord(dir, push_constants.camera_basis[3][1])).rgb;
  }
  imageStore(
    storage_images[push_constants.irradiance_image],
    pixel,
    vec4(irradiance, 1.0));
  imageStore(
    storage_uimages[push_constants.rng_state_image],
    pixel,
    uvec4(random.state));
}
