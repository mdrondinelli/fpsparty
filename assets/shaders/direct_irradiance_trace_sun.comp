#version 450

#include "atmosphere/sky_irradiance.glsl"
#include "direct_irradiance_common.glsl"
#include "octahedral.glsl"
#include "rt.glsl"
#include "sampling.glsl"

layout(local_size_x = 64) in;

// Sun half of pass 2 (direct_irradiance_trace_sky.comp is the other half).
// Reads back the Distant_light_sample records direct_irradiance.comp (pass
// 1) appended to sun_samples, traces one ray each, shades, and writes the
// result to direct_irradiance_image at the sample's stored pixel. Every
// sample here is a sun sample -- no is_sun check, no branch on technique --
// so this dispatch is a tiny cone of directions around one fixed global
// direction, which is what makes it ray-coherent. 1D dispatch over a
// worst-case thread count (every pixel could have produced a sun sample);
// threads past the real count (pass 1's final atomic counter value) just
// return.
layout(push_constant) uniform Push_constants {
  layout(offset = 0) Scene scene;
  layout(offset = 8) uint16_t normal_texture;
  layout(offset = 10) uint16_t depth_texture;
  layout(offset = 12) uint16_t direct_irradiance_image;
  layout(offset = 14) uint16_t transmittance_texture;
  layout(offset = 16) Sky_irradiance sky_irradiance;
  layout(offset = 24) Distant_light_samples sun_samples;
  layout(offset = 32) Rt_block_grid rt_block_grid;
  layout(offset = 40) Rt_entities entities;
  layout(offset = 48) Rt_entity_grid entity_grid;
  layout(offset = 56) Rt_entity_nodes entity_nodes;
} push_constants;

void main() {
  const uint index = gl_GlobalInvocationID.x;
  if (index >= push_constants.sun_samples.count) {
    return;
  }
  const Distant_light_sample light_sample =
    push_constants.sun_samples.samples[index];
  const ivec2 size =
    imageSize(storage_images[push_constants.direct_irradiance_image]);
  const ivec2 pixel = ivec2(
    int(light_sample.pixel % uint(size.x)),
    int(light_sample.pixel / uint(size.x)));
  const vec3 sun_direction = push_constants.scene.sun_direction;
  // Redo pass 1's dir warp from the stored uniform samples against this
  // (fixed) technique's basis rather than reading a stored dir -- see
  // Distant_light_sample.
  const vec3 dir =
    make_basis(sun_direction) *
    square_to_cone(unpackUnorm2x16(light_sample.uv), cos_sun_angular_radius);

  const float depth =
    texelFetch(sampled_images[push_constants.depth_texture], pixel, 0).r;
  const vec2 ndc = (vec2(pixel) + 0.5) / vec2(size) * 2.0 - 1.0;
  const vec3 view_ray = vec3(
    -ndc.x * push_constants.scene.zoom.x,
    -ndc.y * push_constants.scene.zoom.y,
    1.0);
  const vec3 camera_position = push_constants.scene.camera_basis[3].xyz;
  const float view_z = push_constants.scene.z_near / depth;
  const vec3 world_position =
    camera_position +
    mat3(push_constants.scene.camera_basis) * (view_ray * view_z);
  const vec3 n = oct_decode(
    texelFetch(
      sampled_images[push_constants.normal_texture], pixel, 0).rg);
  const vec3 sun_transmittance =
    transmittance_along_ray(
      push_constants.transmittance_texture,
      vec3(0.0, r_ground + world_position.y, 0.0),
      sun_direction);
  const vec3 ray_origin = offset_ray_origin(world_position, n);

  const bool occluded = trace_ray(
    push_constants.rt_block_grid,
    push_constants.entities,
    push_constants.entity_grid,
    push_constants.entity_nodes,
    ray_origin,
    dir,
    true);

  const vec3 f_true =
    eval_f_true_sun(dir, n, sun_transmittance, push_constants.scene) *
    (occluded ? 0.0 : 1.0);
  const float pdf_dir = 1.0 / sun_solid_angle;

  // Same technique-selection probability as pass 1, re-derived rather than
  // stored (see direct_irradiance.comp).
  const vec3 unshadowed_sun =
    eval_f_true_sun(sun_direction, n, sun_transmittance, push_constants.scene);
  const vec3 unshadowed_sky =
    sample_sky_irradiance(push_constants.sky_irradiance, n);
  const float l_sun = luminance(unshadowed_sun) * sun_solid_angle;
  const float l_sky = luminance(unshadowed_sky);
  const float total = l_sun + l_sky;
  const float p_sun = total > 0.0 ? l_sun / total : 0.5;
  const float technique_pdf = p_sun;

  // Mixture-source one-sample MIS: f_true / (technique_pdf * pdf_dir).
  const vec3 E =
    pdf_dir > 0.0
      ? sanitize(f_true / (technique_pdf * pdf_dir), vec3(0.0))
      : vec3(0.0);
  imageStore(
    storage_images[push_constants.direct_irradiance_image],
    pixel,
    vec4(E, 1.0));
}
